# REIT Target AI — Environment Variables
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to git.

# Gemini API key — get one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model. The 1.x and 2.x families are retired; these are current.
GEMINI_MODEL=gemini-3.1-flash-lite

# Tried in order when the primary model's daily quota is exhausted.
# Free-tier quota is counted per model per day, so listing several gives the
# demo a much larger combined allowance.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.7-flash

# Output budget per call. Gemini 3.x spends this budget on internal reasoning
# too, so a small value truncates replies mid-JSON.
GEMINI_MAX_OUTPUT_TOKENS=4096

# Server port (optional — defaults to 3001)
PORT=3001

# Network interface (optional). Defaults to 127.0.0.1, so only this machine can
# reach the proxy. Set REIT_HOST=0.0.0.0 only if you deliberately want other
# devices on your network to use it (and spend your key).
# REIT_HOST=127.0.0.1
